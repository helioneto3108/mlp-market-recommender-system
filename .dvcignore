# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Sistema operacional
.DS_Store

.gitkeep

# Caches do Python — binários específicos de cada máquina; sem estas linhas,
# o DVC os inclui no hash dos diretórios de src/ e o `dvc status` acusa
# mudanças falsas em qualquer outra máquina.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
