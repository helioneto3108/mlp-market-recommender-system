# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE
# Instruções: copie este arquivo, renomeie para '.env' e preencha.
# O '.env' está no .gitignore (NÃO é versionado). Trocar de provedor
# (local ↔ GCP) deve exigir apenas a edição deste arquivo.
# ==============================================================================

# ── MLflow (tracking + Model Registry) ────────────────────────────────────────
# Local (docker-compose):  http://localhost:5000
# GCP (Cloud Run):         https://mlflow-XXXXXXXX-uc.a.run.app
MLFLOW_TRACKING_URI=http://localhost:5000

# Credenciais só se o servidor exigir autenticação básica.
# O servidor local do docker-compose não exige — deixe em branco.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Nome do experimento padrão no MLflow
MLFLOW_EXPERIMENT_NAME=mlp-market-recommender-system-temporal-v1

# ── DVC / Google Cloud Storage ────────────────────────────────────────────────
# O remote fica em .dvc/config (gs://mlp-market-recommender-gp16/dvc).
# A autenticação NÃO usa variável aqui: rode uma vez na máquina
#   gcloud auth application-default login
# (containers usam service account — ver docs de deploy).

# ── Reprodutibilidade ────────────────────────────────────────────────────────
RANDOM_SEED=42
