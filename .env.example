# ───────────────────────────────────────────────────────────────────
# Configuração de ambiente — copie para `.env` e preencha os segredos.
# O arquivo `.env` está no .gitignore (NÃO é versionado).
# ───────────────────────────────────────────────────────────────────

# MLflow tracking hospedado no DagsHub.
# Use o "Default Access Token" (Settings > Tokens) — o MESMO token nos dois campos.
MLFLOW_TRACKING_URI=https://dagshub.com/9MLET-GP16-Team/mlp-market-recommender-system.mlflow
MLFLOW_TRACKING_USERNAME=<seu_token_dagshub>
MLFLOW_TRACKING_PASSWORD=<seu_token_dagshub>

# Nome do experimento no MLflow
MLFLOW_EXPERIMENT_NAME=instacart-recommender

# (futuro) DVC remote no DagsHub — usado na etapa de versionamento de dados
# DVC_REMOTE_URL=s3://dvc
# DVC_REMOTE_ENDPOINT=https://dagshub.com/9MLET-GP16-Team/mlp-market-recommender-system.s3
