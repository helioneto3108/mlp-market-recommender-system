# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE
# ==============================================================================
# Instruções:
# 1. Copie este arquivo:
#      cp .env.example .env
#
# 2. Edite o arquivo .env conforme o ambiente usado.
#
# O arquivo .env está no .gitignore e NÃO deve ser versionado.
# Este .env.example pode ser commitado porque não contém segredos.
# ==============================================================================


# ── MLflow: Tracking + Model Registry ─────────────────────────────────────────
# Escolha apenas UMA opção para MLFLOW_TRACKING_URI no arquivo .env.

# Opção 1 — MLflow local via docker-compose
# Use quando rodar:
#   docker compose up mlflow
# URL:
#   http://localhost:5000

# Opção 2 — MLflow Cloud Run via proxy autenticado
# Use enquanto o serviço Cloud Run ainda não estiver público.
# Antes de rodar scripts locais, mantenha aberto em outro terminal:
#   gcloud run services proxy mlflow --region=us-central1 --port=8080
# URL:
#   http://localhost:8080

# Opção 3 — MLflow Cloud Run público
# Use quando o acesso público for liberado com Cloud Run Invoker para allUsers.
# URL atual do serviço:
#   https://mlflow-876475431643.us-central1.run.app

MLFLOW_TRACKING_URI=http://localhost:5000

# Credenciais só se o servidor MLflow exigir autenticação básica.
# O MLflow local, o proxy do Cloud Run e o serviço atual não usam usuário/senha.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Nome do experimento padrão no MLflow.
MLFLOW_EXPERIMENT_NAME=mlp-market-recommender-system-temporal-v1


# ── DVC / Google Cloud Storage ────────────────────────────────────────────────
# O remote do DVC fica configurado em:
#   .dvc/config
#
# Bucket usado pelo projeto:
#   gs://mlp-market-recommender-gp16/dvc
#
# Para autenticar o DVC localmente, rode uma vez:
#   gcloud auth application-default login
#
# Para conferir:
#   gcloud auth application-default print-access-token
#
# Não coloque tokens ou credenciais aqui.


# ── Reprodutibilidade ────────────────────────────────────────────────────────
RANDOM_SEED=42
